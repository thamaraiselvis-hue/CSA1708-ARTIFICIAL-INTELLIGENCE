# Vacuum Cleaner Problem

def vacuum_cleaner():
    # Environment
    rooms = {
        "A": "Dirty",
        "B": "Dirty"
    }

    print("Initial State:")
    print(rooms)

    # Start from Room A
    current_room = "A"

    while True:
        print("\nVacuum is in Room", current_room)

        if rooms[current_room] == "Dirty":
            print("Cleaning Room", current_room)
            rooms[current_room] = "Clean"
        else:
            print("Room", current_room, "is already Clean")

        # Move to the next room
        if current_room == "A":
            current_room = "B"
        else:
            break

    print("\nFinal State:")
    print(rooms)

# Run the program
vacuum_cleaner()
