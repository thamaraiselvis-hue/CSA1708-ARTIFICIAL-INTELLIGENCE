from heapq import heappush, heappop

# Goal State
goal = ((1, 2, 3),
        (4, 5, 6),
        (7, 8, 0))

# Manhattan Distance Heuristic
def heuristic(state):
    distance = 0
    for i in range(3):
        for j in range(3):
            value = state[i][j]
            if value != 0:
                goal_x = (value - 1) // 3
                goal_y = (value - 1) % 3
                distance += abs(i - goal_x) + abs(j - goal_y)
    return distance

# Find position of blank (0)
def find_blank(state):
    for i in range(3):
        for j in range(3):
            if state[i][j] == 0:
                return i, j

# Generate neighboring states
def neighbors(state):
    x, y = find_blank(state)
    moves = [(-1,0), (1,0), (0,-1), (0,1)]

    for dx, dy in moves:
        nx, ny = x + dx, y + dy
        if 0 <= nx < 3 and 0 <= ny < 3:
            temp = [list(row) for row in state]
            temp[x][y], temp[nx][ny] = temp[nx][ny], temp[x][y]
            yield tuple(tuple(row) for row in temp)

# A* Search Algorithm
def solve(start):
    pq = []
    heappush(pq, (heuristic(start), 0, start, []))
    visited = set()

    while pq:
        f, g, state, path = heappop(pq)

        if state in visited:
            continue

        visited.add(state)
        path = path + [state]

        if state == goal:
            return path

        for next_state in neighbors(state):
            if next_state not in visited:
                heappush(pq, (g + 1 + heuristic(next_state),
                              g + 1,
                              next_state,
                              path))
    return None

# Print the solution
def print_solution(path):
    for step, state in enumerate(path):
        print(f"Step {step}:")
        for row in state:
            print(row)
        print()

# Example Initial State
start = ((1, 2, 3),
         (4, 0, 6),
         (7, 5, 8))

solution = solve(start)

if solution:
    print("Solution Found!\n")
    print_solution(solution)
else:
    print("No Solution Exists.")
