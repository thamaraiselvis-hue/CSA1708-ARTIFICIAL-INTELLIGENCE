# A* Algorithm

graph = {
    'A': [('B', 1), ('C', 3)],
    'B': [('D', 3), ('E', 1)],
    'C': [('F', 5)],
    'D': [],
    'E': [('F', 2)],
    'F': []
}

# Heuristic values
heuristic = {
    'A': 6,
    'B': 4,
    'C': 4,
    'D': 2,
    'E': 2,
    'F': 0
}

def a_star(start, goal):
    open_list = [(start, 0)]
    g_cost = {start: 0}
    parent = {start: None}

    while open_list:
        # Select node with minimum f(n)
        current = min(open_list, key=lambda x: x[1] + heuristic[x[0]])
        open_list.remove(current)

        node = current[0]

        if node == goal:
            path = []
            while node:
                path.append(node)
                node = parent[node]
            return path[::-1]

        for neighbor, cost in graph[node]:
            new_cost = g_cost[current[0]] + cost

            if neighbor not in g_cost or new_cost < g_cost[neighbor]:
                g_cost[neighbor] = new_cost
                parent[neighbor] = current[0]
                open_list.append((neighbor, new_cost))

    return None

# Driver Code
path = a_star('A', 'F')

print("Shortest Path:", path)
