from itertools import permutations

# Distance matrix
graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

n = len(graph)
cities = range(n)

min_cost = float('inf')
best_path = ()

# Generate all possible routes
for path in permutations(cities):
    if path[0] == 0:   # Start from city 0
        cost = 0
        for i in range(n - 1):
            cost += graph[path[i]][path[i + 1]]
        cost += graph[path[-1]][path[0]]  # Return to start

        if cost < min_cost:
            min_cost = cost
            best_path = path

print("Minimum Cost:", min_cost)
print("Optimal Path:", best_path + (0,))
