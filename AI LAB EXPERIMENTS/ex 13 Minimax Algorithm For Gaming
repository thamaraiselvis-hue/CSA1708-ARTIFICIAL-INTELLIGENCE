# Minimax Algorithm

def minimax(depth, node, isMax, scores, height):
    if depth == height:
        return scores[node]

    if isMax:
        return max(
            minimax(depth + 1, node * 2, False, scores, height),
            minimax(depth + 1, node * 2 + 1, False, scores, height)
        )
    else:
        return min(
            minimax(depth + 1, node * 2, True, scores, height),
            minimax(depth + 1, node * 2 + 1, True, scores, height)
        )

scores = [3, 5, 2, 9, 12, 5, 23, 23]
height = 3

best = minimax(0, 0, True, scores, height)

print("The optimal value is:", best)
